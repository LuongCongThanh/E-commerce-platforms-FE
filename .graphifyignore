# graphifyignore - exclude files from knowledge graph
# Format: gitignore-style patterns

# i18n translation files — pure data, no meaningful relationships
src/lang/

# Service worker — isolated by design (no app imports)
src/app/sw.ts

# Root redirect page — just redirects to /vi, no domain logic
src/app/page.tsx

# Generated/build artifacts
.next/
node_modules/
graphify-out/

# Test fixtures and snapshots
**/__snapshots__/
**/*.test.ts.snap

# Config files — tooling, not domain logic
*.config.ts
*.config.mjs
*.config.js
